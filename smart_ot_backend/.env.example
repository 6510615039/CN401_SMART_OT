TU_API_KEY=your_tu_api_key_here
TU_API_URL=https://restapi.tu.ac.th

# ตั้ง DB_ENGINE=mysql เพื่อใช้ MySQL แทน sqlite (ไม่ตั้งค่า = ใช้ sqlite ตามค่า default สำหรับ dev)
DB_ENGINE=mysql
DB_NAME=smart_ot
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# สมัครฟรีที่ resend.com → API Keys → Create API Key
# free tier: 3,000 email/เดือน เพียงพอสำหรับองค์กรขนาดกลาง
RESEND_API_KEY=re_your_api_key_here

# ชื่อและอีเมลที่แสดงเป็น sender (ถ้าไม่ได้ verify domain ให้ใช้ค่า default ด้านล่าง)
DEFAULT_FROM_EMAIL=SMART OT <onboarding@resend.dev>
