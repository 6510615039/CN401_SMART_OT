TU_API_KEY=your_tu_api_key_here
TU_API_URL=https://restapi.tu.ac.th

# ตั้ง DB_ENGINE=mysql เพื่อใช้ MySQL แทน sqlite (ไม่ตั้งค่า = ใช้ sqlite ตามค่า default สำหรับ dev)
DB_ENGINE=mysql
DB_NAME=smart_ot
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# ─── Email (Mailjet SMTP) ─────────────────────────────────────────────────────
# สมัครฟรีที่ mailjet.com → Account Settings → REST API → API Key Management
# free tier: 6,000 email/เดือน, 200/วัน เพียงพอสำหรับองค์กรขนาดกลาง
EMAIL_HOST=in-v3.mailjet.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_mailjet_api_key
EMAIL_HOST_PASSWORD=your_mailjet_secret_key

# ชื่อและอีเมลที่แสดงเป็น sender (ใช้อีเมลที่สมัคร Mailjet)
DEFAULT_FROM_EMAIL="SMART OT <your_email@gmail.com>"
